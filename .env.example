# Copie para .env.local (local) e configure na Vercel (produção). NUNCA commitar .env.local.

# Chave gerada no Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=

# Modelo lido pelo back-end. Confirme o modelo atual e a cota gratuita no AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Rate limit por IP no /api/analisar (análises por hora)
RATE_LIMIT_PER_HOUR=5
